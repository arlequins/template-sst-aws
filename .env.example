# Never commit a real address or account identifier.
AWS_REGION=ap-northeast-1
BUDGET_ALERT_EMAIL=cloud-alerts@example.com
MONTHLY_BUDGET_USD=20

# Explicit acknowledgement prevents accidental account-wide changes.
ACKNOWLEDGE_ACCOUNT_BASELINE=true

# Enable only after confirming that this account has no existing organization trail.
ENABLE_AUDIT_TRAIL=false
